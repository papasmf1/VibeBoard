# Supabase Configuration
# Get these values from your Supabase project dashboard at https://supabase.com
# Project Settings -> API Keys
#
# These are the only two variables lib/supabase.ts reads. Never commit real
# values here — this file is checked into git; put actual keys in .env.local
# (already gitignored) instead.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
